[Desktop Entry]
Type=Application
Name=photto
GenericName=File Sorter
Comment=Swipe through photos, videos and files: keep, favorite or trash
Exec=photto --gui %f
Icon=photto
Terminal=false
StartupNotify=true
StartupWMClass=photto
Categories=Utility;FileTools;Graphics;
Keywords=photos;gallery;cleanup;tinder;swipe;declutter;duplicates;trash;
