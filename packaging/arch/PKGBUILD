# Maintainer: laghab
pkgname=sift
pkgver=1.2.0
pkgrel=1
pkgdesc="Local file review and OCR text search GUI"
arch=('any')
url="https://github.com/laghab/sift"
license=('MIT')
depends=('python' 'python-gobject' 'webkit2gtk-4.1' 'glib2')
optdepends=('ffmpeg: video thumbnails and info'
            'ffmpegthumbnailer: faster video thumbnails'
            'poppler: PDF thumbnails and pages'
            'imagemagick: HEIC/RAW/TIFF photos'
            'libvips: faster image thumbnails'
            'libreoffice-fresh: previews of Office documents'
            'gst-plugins-good: more video formats in the native window'
            'gst-libav: more video formats in the native window')
makedepends=('git')
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

package() {
  cd "$pkgname"
  install -Dm644 photto.py "$pkgdir/usr/lib/sift/photto.py"
  install -Dm644 sift_ocr.py "$pkgdir/usr/lib/sift/sift_ocr.py"
  cp -r static "$pkgdir/usr/lib/sift/"
  install -dm755 "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec python3 /usr/lib/sift/photto.py "$@"\n' > "$pkgdir/usr/bin/sift"
  chmod 755 "$pkgdir/usr/bin/sift"
  install -Dm644 data/sift.desktop "$pkgdir/usr/share/applications/sift.desktop"
  install -Dm644 data/sift.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/sift.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
